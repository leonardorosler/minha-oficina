# Banco PostgreSQL (Neon ou outro provedor)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredo usado para assinar os tokens JWT
JWT_SECRET="troque-por-um-segredo-forte"

# Porta local da API (o Render define automaticamente em produção)
PORT=3333

# URL do frontend autorizada pelo CORS
# Em produção no Render, use a URL da Vercel:
# FRONTEND_URL="https://minha-oficina-frontend.vercel.app"
FRONTEND_URL="http://localhost:5173"

# development local | production no Render
NODE_ENV="development"
